# Скопируй этот файл в .env и поправь под себя: cp .env.example .env

# Порт, на котором поднимется API (http://localhost:3000)
PORT=3000

# Откуда фронту разрешено ходить в API (через запятую)
CORS_ORIGINS=http://localhost:5173

# Подключение к PostgreSQL (совпадает с docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=theboys
DB_PASSWORD=theboys
DB_NAME=theboys

# Секрет для подписи JWT. В проде обязательно длинная случайная строка!
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Сколько минут держим место за неоплаченной бронью
BOOKING_HOLD_MINUTES=10

# Платёжный провайдер: пока только mock (тестовая оплата без денег)
PAYMENT_PROVIDER=mock
